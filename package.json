{
  "name": "rumi",
  "version": "0.4.0",
  "private": true,
  "description": "A quiet place to write, with agents working beside your words.",
  "type": "module",
  "keywords": [
    "pi-package",
    "writing",
    "agents"
  ],
  "bin": {
    "rumi": "bin/rumi.mjs"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "probe": "node probe.mjs",
    "verify:proof": "node verify-proof.mjs",
    "test": "node --test test/*.test.mjs",
    "package": "node scripts/package.mjs"
  },
  "pi": {
    "extensions": [
      "./pi/cli.mjs"
    ],
    "skills": [
      "./pi/skills"
    ]
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@mozilla/readability": "0.6.0",
    "express": "5.1.0",
    "jsdom": "26.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@tiptap/react": "3.7.2",
    "@tiptap/starter-kit": "3.7.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  }
}
